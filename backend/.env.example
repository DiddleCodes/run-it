# --- Core ---
NODE_ENV=development
PORT=3000
# Origin(s) allowed to call this API cross-origin — the web dashboard's own
# Next.js server, not the browser (see main.ts). Comma-separated.
DASHBOARD_ORIGIN=http://localhost:3001

# --- Database / cache ---
DATABASE_URL=postgresql://runit:runit@localhost:5432/runit_payments
REDIS_URL=redis://localhost:6379

# --- Paystack ---
# Secret key: server-side only, never shipped to the client.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
# Must match the callBackUrl the Flutter client passes to flutter_paystack_plus.
PAYSTACK_CALLBACK_URL=https://runit.app/payments/callback

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- Commission / delivery fee (see README's "Commission split" section) ---
# 0-1, applied to the food subtotal only (never the delivery fee).
RESTAURANT_COMMISSION_RATE=0.15
# 0-1, the runner's cut of the delivery fee. The platform keeps the
# remainder of the delivery fee (never the food subtotal).
RUNNER_DELIVERY_FEE_SHARE=0.85
# Kobo. Flat for now (₦350) — a clear extension point for future
# distance-based tiering, not built yet.
DEFAULT_DELIVERY_FEE=35000

# --- Internal service auth for escrow release/refund ---
# Shared secret the delivery-confirmation flow (or an admin tool) presents
# via the X-Internal-Api-Key header, in addition to / instead of a JWT
# carrying role=internal_service or role=admin.
INTERNAL_SERVICE_API_KEY=change-me-internal-key

# --- Image uploads (Task 9): S3 presigned PUT URLs ---
AWS_REGION=us-east-1
S3_UPLOADS_BUCKET=run-it-uploads
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
# Optional: a CDN/custom domain fronting the bucket. Falls back to the
# bucket's default virtual-hosted-style S3 URL when unset.
# S3_PUBLIC_BASE_URL=https://cdn.runit.app

# --- Payment hardening (Task 9b) ---
# Comma-separated. Defaults to Paystack's published webhook IPs if unset.
# Only enforced when NODE_ENV=production — see PaystackWebhookIpGuard.
# PAYSTACK_WEBHOOK_IP_ALLOWLIST=52.31.139.75,52.49.173.169,52.214.14.220
# How often the reconciliation sweep runs, and how old a pending row must be
# before the sweep bothers re-verifying it with Paystack.
RECONCILE_INTERVAL_MINUTES=5
RECONCILE_STALE_THRESHOLD_MINUTES=10
# Optional: Slack incoming webhook URL for reconciliation/transfer-failure
# alerts. Alerts degrade to a logged warning when unset.
# SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- Mobile OTP delivery (Task 20): Brevo transactional email ---
# Optional: without these, student/email OTP requests degrade to a
# dev-only log line outside production, and to a logged warning (no code
# logged) in production. Runner/phone OTP has no delivery channel yet
# regardless (SMS is a future task) and always logs — see AuthService.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=otp@runit.app
# BREVO_SENDER_NAME=RUN-It
