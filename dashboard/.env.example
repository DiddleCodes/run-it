# Copy to .env.local for local development (`cp .env.example .env.local`).
# In production, set these on the host instead — see README.md → Production.

# The NestJS backend. Server-only: the browser never sees it.
BACKEND_URL=http://localhost:3000

# Must be exactly the backend's JWT_SECRET (backend/.env) — the dashboard
# verifies the tokens the backend signs.
JWT_SECRET=

# Optional: error reporting. Inlined at BUILD time (NEXT_PUBLIC_), so it must
# be set when `next build` runs, not just at start. Empty = Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
